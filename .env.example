# Copy to backend/.env for local development. Never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://jewelry:jewelry@localhost:5432/jewelry

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Search ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=local-dev-master-key

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=jewelry
S3_SECRET_KEY=jewelry-local
S3_BUCKET=jewelry-media

# --- Tenancy ---
# Slug of the tenant used when no domain match is found (single-tenant MVP).
DEFAULT_TENANT_SLUG=default

# --- App ---
ENVIRONMENT=local
